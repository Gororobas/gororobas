{
  "name": "pleat-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "bench": "pnpm --dir bench run bench",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:browser && pnpm site:build",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --deny-warnings --disable-nested-config . && pnpm --dir site lint",
    "chromium:install": "pnpm --dir test/browser exec playwright-core install chromium",
    "site:setup": "pnpm --dir site run setup",
    "site:deploy": "pnpm --dir site run deploy",
    "site:secrets": "pnpm --dir site run secrets"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
