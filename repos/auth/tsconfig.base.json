{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "effectFn": ["span", "untraced"],
        "allowedUnstableApis": [
          "@effect/atom-react",
          "@effect/platform-bun",
          "@effect/platform-node",
          "@effect/sql-d1",
          "@effect/sql-libsql",
          "@effect/sql-mysql2",
          "@effect/sql-pg",
          "@effect/sql-pglite",
          "@effect/sql-sqlite-bun",
          "@effect/sql-sqlite-do",
          "@effect/sql-sqlite-node",
          "@effect/sql-sqlite-wasm",
          "@effect/vitest",
          "effect/Crypto",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/ai",
          "effect/cli",
          "effect/http",
          "effect/http-api",
          "effect/persistence/KeyValueStore",
          "effect/persistence/RateLimiter",
          "effect/process",
          "effect/reactivity",
          "effect/rpc",
          "effect/sql"
        ],
        "diagnosticSeverity": {
          "unknownRuleName": "error",
          "catchIfTagToCatchTag": "warning",
          "catchRefailToTapError": "warning",
          "flatMapIgnoredParamToAndThen": "warning",
          "anyUnknownInErrorContext": "warning",
          "instanceOfSchema": "suggestion",
          "nestedEffectGenYield": "suggestion",
          "newSchemaClass": "error",
          "preferSchemaTypeProperty": "suggestion",
          "preferTypedSchemaDecoder": "error",
          "unsafeEffectTypeAssertion": "warning",
          "floatingEffect": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "extendsNativeError": "error"
        },
        "overrides": [
          {
            "include": ["**/src/**/*.ts"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "warning",
                "preferSchemaOverJson": "suggestion"
              }
            }
          }
        ]
      }
    ]
  }
}
