{
  "name": "yielded-auth-monorepo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent --hooks-dir .vite-hooks",
    "patch:tsgo": "effect-tsgo patch --typescript",
    "changeset": "bun x changeset",
    "changeset:version": "bun x changeset version",
    "ci:version": "bun x changeset version && bun install",
    "check": "vp check && vp run -r --concurrency-limit 1 check && vp run check:scripts && vp run check:exports && vp run verify:package-purity",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:exports": "bun scripts/verify-package-exports.ts",
    "verify:package-purity": "bun scripts/verify-package-purity.ts",
    "check:package-consumers": "bun scripts/verify-package-consumers.ts",
    "test": "vp test --dir scripts/test && vp run -r --parallel --concurrency-limit 4 test",
    "build": "vp run -r build && vp run check:package-consumers",
    "ready": "vp run check && vp run test && vp run build",
    "docs:dev": "vp run @yielded/auth-docs#dev",
    "docs:build": "vp run @yielded/auth-docs#build",
    "docs:preview": "vp run @yielded/auth-docs#preview",
    "release:checked-publish": "vp run --no-cache release:publish --check-ready"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@effect/atom-react": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@yielded/auth": "workspace:*",
    "@yielded/auth-crypto": "workspace:*",
    "@yielded/auth-openid-client": "workspace:*",
    "@yielded/auth-persistence": "workspace:*",
    "@yielded/auth-persistence-drizzle": "workspace:*",
    "@yielded/auth-simplewebauthn": "workspace:*",
    "alchemy": "catalog:",
    "effect": "catalog:",
    "esbuild": "catalog:",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-twoslash": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@cloudflare/workers-types": "5.20260926.1",
