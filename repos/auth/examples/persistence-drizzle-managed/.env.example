# No configuration is needed for local development. Email goes to .data/mail/.
# AUTH_EMAIL_DELIVERY=local
# AUTH_DATA_DIR=./.data

# To send real email, set all four values and use a verified sending domain.
# AUTH_EMAIL_DELIVERY=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# AUTH_EMAIL_FROM=hello@example.com
