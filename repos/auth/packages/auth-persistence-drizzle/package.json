    "@effect/sql-sqlite-do": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@effect/sql-sqlite-wasm": "catalog:",
    "@effect/vitest": "catalog:",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
