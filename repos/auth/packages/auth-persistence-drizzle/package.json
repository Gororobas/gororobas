{
  "name": "@yielded/auth-persistence-drizzle",
  "version": "0.1.0-beta.18",
  "description": "Drizzle persistence, table mappings, and migration adapters for Yielded Auth.",
  "homepage": "https://yielded.dev/auth/",
  "bugs": {
    "url": "https://github.com/yielded-dev/auth/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yielded-dev/auth.git",
    "directory": "packages/auth-persistence-drizzle"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./D1": "./src/D1.ts",
    "./Libsql": "./src/Libsql.ts",
    "./Mysql2": "./src/Mysql2.ts",
    "./Pglite": "./src/Pglite.ts",
    "./Postgres": "./src/Postgres.ts",
    "./SqliteBun": "./src/SqliteBun.ts",
    "./SqliteDo": "./src/SqliteDo.ts",
    "./SqliteNode": "./src/SqliteNode.ts",
    "./SqliteWasm": "./src/SqliteWasm.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --passWithNoTests",
    "example:totp": "bun test/fixtures/totp-sqlite-bun.ts"
  },
  "dependencies": {
    "@noble/hashes": "catalog:",
