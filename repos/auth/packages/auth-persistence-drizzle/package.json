  "peerDependencies": {
    "@effect/sql-d1": ">=4.0.0",
    "@effect/sql-libsql": ">=4.0.0",
    "@effect/sql-mysql2": ">=4.0.0",
    "@effect/sql-pg": ">=4.0.0",
    "@effect/sql-pglite": ">=4.0.0",
    "@effect/sql-sqlite-bun": ">=4.0.0",
    "@effect/sql-sqlite-do": ">=4.0.0",
