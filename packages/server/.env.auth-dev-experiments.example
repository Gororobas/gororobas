NODE_ENV=development
AUTH_ORIGIN=https://localhost:4443
# Generate: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
AUTH_BINDING_KEY=
MAILPIT_URL=http://localhost:8025
AUTH_EMAIL_FROM=auth@gororobas.local
# Production requires NODE_ENV=production, RESEND_API_KEY and a verified AUTH_EMAIL_FROM.
# RESEND_API_KEY=

# Optional OAuth providers: set both variables to enable a provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=  # Apple ES256 client-secret JWT; rotate before expiry.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
