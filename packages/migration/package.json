{
  "name": "@gororobas/migration",
  "version": "0.0.0",
  "description": "Migration from Gel/EdgeDB to SQLite with Effect",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "preview:sqlite": "node --import tsx src/import-preview.ts",
    "preview": "node --import tsx src/preview-server.ts",
    "test:preview": "vitest run src/preview.test.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest",
    "migrate": "tsx src/index.ts",
    "generate:gel": "npx @gel/generate edgeql-js --out src/gel --future-polymorphism-as-discriminated-unions --future-strict-type-names",
    "generate:interfaces": "npx @gel/generate interfaces --file src/gel.interfaces.ts",
    "generate:all": "pnpm generate:gel && pnpm generate:interfaces",
    "download:images": "node --import tsx src/download-sanity-images.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@gororobas/domain": "workspace:^",
    "@gororobas/server": "workspace:^",
    "effect": "catalog:",
    "gel": "^2.2.1",
    "json-diff-ts": "^4.10.4",
    "loro-crdt": "catalog:",
    "loro-mirror": "catalog:"
  },
  "devDependencies": {
    "@gel/generate": "^0.7.1",
    "@types/node": "26.6.3",
    "tsx": "latest",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "effect": {
    "generateExports": {
      "include": [
        "**/*.ts"
      ]
    },
    "generateIndex": {
      "include": [
        "**/*.ts"
      ]
    }
  }
}
