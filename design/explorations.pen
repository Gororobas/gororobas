                          "name": "Primeira contribuição? J",
                          "fill": "#3e1c2aff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Primeira contribuição? Já teve aprovações? A fonte é um livro da enciclopédia? Há outras sugestões pendentes no mesmo campo?",
                          "lineHeight": 1.4,
                          "fontFamily": "Alan Sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
