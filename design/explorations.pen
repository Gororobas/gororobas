                        {
                          "type": "text",
                          "id": "yY1C5",
                          "name": "Avaliação é uma união et",
                          "fill": "#3e1c2aff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Avaliação é uma união etiquetada (aprovado sempre diz por quem e quando). Contestar nunca censura: põe o claim na fila. Reverter um changeset é retratar seus claims.",
                          "lineHeight": 1.4,
                          "fontFamily": "Alan Sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    }
