                    {
                      "type": "text",
                      "id": "m9RsAh",
                      "name": "Toda contribuição termin",
                      "fill": "#3e1c2aff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Toda contribuição termina num changeset com resumo e fonte. Valores de pessoas se corrigem; valores de máquinas se endossam ou contestam. A pessoa vê sua sugestão pendente no lugar.",
