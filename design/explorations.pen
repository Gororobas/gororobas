                          "name": "Princípio",
                          "fill": "#7a4b59ff",
                          "textGrowth": "fixed-width",
                          "width": 150,
                          "content": "Princípio",
                          "lineHeight": 1.3,
                          "fontFamily": "Alan Sans",
                          "fontSize": 14,
                          "fontWeight": "700"
                        },
                        {
                          "type": "text",
                          "id": "IzPfY",
                          "name": "Avaliar por item, mas le",
                          "fill": "#3e1c2aff",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "Avaliar por item, mas ler o todo. Aprovar metade de um changeset é normal; o que não pode é aprovar metade de um valor (intervalos são um valor só).",
                          "lineHeight": 1.4,
                          "fontFamily": "Alan Sans",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        }
                      ]
                    },
