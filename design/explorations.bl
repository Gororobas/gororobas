          99f03cb3efac575d t("Situada · faixa · herança",Alan Sans,12,sb,align(l),lh(1.35)) p(10,3) s(fill,hug:16.21) ext(131.32,) f[(16ab3b19718d5471,#0C2B28)] "Text 10"
        c5eaea8b18e434ab t("Uma faixa com a distribuição, quem ficou fora da conta e a espécie ao lado, sem misturar.",Alan Sans,13,r,align(l),lh(1.35)) p(16,74.46) s(fill,hug:35.11) ext(296,) f[(bbc9bb8444ec30ea,#6F3E4D)] "Text 11"
