          44d594a072ce2701 t("A origem fica ao lado do rótulo, sempre. É o toque que abre a gaveta; o valor em si segue sendo link.",Alan Sans,13,r,align(l),lh(1.35)) p(0,20.21) s(fill,hug:35.11) ext(375,) f[(b3eae26b1c9e2529,#6F3E4D)] "Text 808"
