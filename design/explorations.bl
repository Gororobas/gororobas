          0fce2b108d7dab1f t("Depende da qualidade da extração; a pessoa pode confirmar sem ler. Precisa deixar o trecho sempre visível e nunca confirmar nada sozinha.",Alan Sans,15,r,align(l),lh(1.4)) p(162,0) s(618,42) f[(a52a21090d54efc7,#3E1C2A)] "Depende da qualidade da "
