      6577a655df671105 t("Ela lê o artigo, estranha um número, vê o que outras pessoas acham dele e sugere um valor melhor, dizendo como sabe.",Alan Sans,16,r,align(l),lh(1.35)) p(0,44) s(1000,22) f[(c349e915cb63069d,tok(pen.tone.neutral.foreground-muted,#6F3E4D))] "Ela lê o artigo, estranha um"
