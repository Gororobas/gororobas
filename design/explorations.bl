    042992feaf08f559 t("Contribuir com um artigo, um pedacinho de cada vez",Alan Sans,40,sb,align(l),lh(1.35)) p(0,0) s(hug:971.25,54) f[(f7d2a68b25c04c72,tok(pen.tone.secondary.emphasis,#A8325D))] "Contribuir com um artigo, um"
    efb7c0007c4aa5ee t("Três portas de entrada na página da Cenoura levam ao mesmo lugar: confirmar (“Parece certo”), contestar (“Está errado”) ou sugerir um valor, sempre uma informação por vez. Confirmar vale na hora; contestar pede um motivo; sugerir pede “como você sabe disso?” e passa por revisão. Cada envio é independente e a tela seguinte convida para a próxima informação.",Alan Sans,17,r,align(l),lh(1.35)) p(0,66) s(1200,69) f[(0663c2e0ee489843,tok(pen.tone.neutral.foreground-muted,#6F3E4D))] "Três portas de entrada na pá"
