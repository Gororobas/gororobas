          db3cf49d4fafe7b1 t("Situada · praça pública",Alan Sans,12,sb,align(l),lh(1.35)) p(10,3) s(fill,hug:16.21) ext(125.26,) f[(21170833e3afce12,#0C2B28)] "Text 13"
        8aba640af0093fb4 t("Como foi, onde foi. Os mesmos relatos aparecem no artigo da planta e no do lugar.",Alan Sans,13,r,align(l),lh(1.35)) p(16,74.46) s(fill,hug:35.11) ext(296,) f[(4a28584988da3cdf,#6F3E4D)] "Text 14"
