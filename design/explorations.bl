          53de1225e3d52930 t("1 · JOANA LÊ O ARTIGO",Alan Sans,12,b,align(l),lh(1.35),ls(1px)) p(0,0) s(hug:155.99,16) f[(c76dfe6bae457404,tok(pen.tone.accent.shade.800,#1C5753))] "1A · ARTIGO COM AS TRÊS PORT"
          a99b792bb39715d4 t("A cenoura dela levou quase 120 dias, e o artigo diz “60 a 80”. Cada linha mostra a origem e um resumo calmo das avaliações. As três portas: “Sugerir edição”, tocar numa informação, e a pergunta do que falta.",Alan Sans,13,r,align(l),lh(1.35)) p(0,20) s(375,72) f[(0e714a6170060146,tok(pen.tone.neutral.foreground-muted,#6F3E4D))] "① “Sugerir edição” no cabeça"
