          f04568e3595e095a t("Proposta e revisão",Alan Sans,12,sb,align(l),lh(1.35)) p(10,3) s(fill,hug:16.21) ext(103.29,) f[(b11e18bddee175d8,#0C2B28)] "Text 805"
      8c8926ba776f9852 t("Toda informação que pessoas podem dar precisa de uma porta, não só quando uma fonte discorda. A origem fica ao lado do nome de cada linha; a gaveta mostra o valor, de onde veio e as respostas, no mesmo tom das de relatos. Para um identificador, sugerir outro é procurar no GBIF e ver antes o que muda junto.",Alan Sans,16,r,align(l),lh(1.35)) p(0,45.8) s(1100,hug:64.81) f[(95101bdfca305b78,#6F3E4D)] "Text 806"
