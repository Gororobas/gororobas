          71554edce871292d t("Agricultoras e agricultores que sabem muito mas não pensam em “campos”. Aproveita o conhecimento em forma de relato, o jeito como ele circula de verdade.",Alan Sans,15,r,align(l),lh(1.4)) p(162,0) s(618,42) f[(9076e7149e799c4c,#3E1C2A)] "Agricultoras e agriculto"
