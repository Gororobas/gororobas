      a7cb60f9d9263dbf t("Chega-se pelo atalho no pé da gaveta (3A), por “Ver o histórico completo” nos detalhes (3B) ou pela aba Contribuições do artigo. Uma linha do tempo só, onde fontes externas e pessoas aparecem lado a lado: avatar redondo para gente, marca quadrada para máquinas.",Alan Sans,16,r,align(l),lh(1.35)) p(0,44) s(900,66) f[(db0dbf93b66d1207,tok(pen.tone.neutral.foreground-muted,#6F3E4D))] "Chega-se pelo atalho no pé d"
