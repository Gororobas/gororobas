          d35471018a05e2e5 t("Situada · valores inteiros",Alan Sans,12,sb,align(l),lh(1.35)) p(10,3) s(fill,hug:16.21) ext(135.83,) f[(508739e1cc166b29,#0C2B28)] "Text 7"
        e7096883d9398926 t("Depende de onde você está. Cumprimenta pelo nome da sua região e vira apelido de URL.",Alan Sans,13,r,align(l),lh(1.35)) p(16,74.46) s(fill,hug:35.11) ext(296,) f[(07f43ebc0a6c2a30,#6F3E4D)] "Text 8"
