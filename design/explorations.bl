    c965f65b998c0c50 t("Tereza e a cenoura: uma história de contribuição",Alan Sans,40,sb,align(l),lh(1.35)) p(0,0) s(hug:887.17,54) f[(2e677f08f5b974db,tok(pen.tone.secondary.emphasis,#A8325D))] "Contribuir com um artigo, um"
    bef98462cee2b696 t("Tereza planta em Urubici, na serra catarinense. Colheu cenoura no fim do inverno, demorou quase quatro meses, e veio ver o que o Gororobas diz. A história segue o que ela toca, tela por tela, em três partes. Depois dela vêm os outros caminhos, o caso em que a sugestão de uma pessoa não vence a fonte externa, e como tudo isso muda em artigos que não são de plantas.",Alan Sans,17,r,align(l),lh(1.35)) p(0,66) s(1300,69) f[(2ddd4257c9fb80a8,tok(pen.tone.neutral.foreground-muted,#6F3E4D))] "Três portas de entrada na pá"
  473a8c5ab34272be fr p(64,271) s(2512,1406) f[] "Etapa · Parte 1 · Joana corrige uma informação"
    2515cd56d942ef85 fr p(0,0) s(1000,66) f[] "Título da etapa"
