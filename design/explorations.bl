          f1f6d26e3f58756a t("Canônica · um valor",Alan Sans,12,sb,align(l),lh(1.35)) p(10,3) s(fill,hug:16.21) ext(108.57,) f[(e54f1840cf79fc61,#0C2B28)] "Text 4"
        37aebd58105276c3 t("Um link simples. A gaveta explica por que este, quem discorda e o histórico.",Alan Sans,13,r,align(l),lh(1.35)) p(16,74.46) s(fill,hug:35.11) ext(296,) f[(dc7637f56f7ffb44,#6F3E4D)] "Text 5"
