        ece8776e64a44207 t("Conte o que você sabe",Alan Sans,40,sb,align(l),lh(1.1)) p(0,33) s(560,44) f[(ab720d6f333473b4,#A8325D)] "Conte o que você sabe"
        0c44d4cc12b5eb41 t("A pessoa escreve do jeito que fala, cola um link ou escolhe um livro. A mesma inferência que lê publicações propõe fatos estruturados, cada um com o trecho que o justifica. A pessoa confirma o que é verdade, e só então eles viram suas afirmações. O que é experiência pessoal pode virar publicação.",Alan Sans,18,r,align(l),lh(1.45)) p(0,89) s(560,130) f[(666da968383ad132,#3E1C2A)] "A pessoa escreve do jeit"
