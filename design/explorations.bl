  e6eb281c7088c252 al(v,g(16)) p(64,64) s(fill,hug:280.43) ext(1704,) f[] "Frame 2"
    30a5f14949ec49fe t("E se cada propriedade tivesse o seu próprio jeito?",Alan Sans,40,sb,align(l),lh(1.35)) p(0,0) s(fill,hug:54) ext(1704,) f[(43c220eae22b2ab6,#A8325D)] "Text 1"
    c8df4f81642339bb t("Cada propriedade é o fim de uma pequena linha de montagem: relatos e fontes externas entram, transformações decidem e a propriedade sai pronta para ser lida — e pode alimentar outras. Como cada uma tem a sua regra, cada uma pode ter a sua cara. Cinco exemplos com temperamentos diferentes, partindo dos esboços de relatos. Cada linha mostra, à esquerda, como a propriedade é calculada e, à direita, como ela aparece.",Alan Sans,17,r,align(l),lh(1.35)) p(0,70) s(1200,hug:68.86) f[(f00d9d16564daa04,#6F3E4D)] "Text 2"
    cc70eb5bff72bdbe al(h,g(16)) p(0,154.86) s(fill,hug:125.57) ext(1704,) f[] "Frame 3"
