{
  "name": "gororobas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint --tsrs",
    "clean": "node scripts/clean.mjs",
    "build": "pnpm --filter @gororobas/web-app build",
    "type-check": "pnpm --recursive --if-present --parallel run type-check && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "effect-tsgo oxlint --deny-warnings --fix --fix-dangerously --fix-suggestions --config=./oxlint.config.ts",
    "lint:check": "effect-tsgo oxlint --deny-warnings --config=./oxlint.config.ts",
    "format": "oxfmt apps packages scripts linting *.ts",
    "format:check": "oxfmt --check apps packages scripts linting *.ts",
    "test": "vitest --run",
    "test:watch": "vitest",
    "check-bdd": "tsx packages/effect-bdd/bin/effect-bdd-check.ts check --paired --quiet --patterns 'apps/server/test/*.feature' --test-pattern 'apps/server/test/*-feature.test.ts'",
    "check-test-inventory": "tsx scripts/check-test-inventory.ts",
    "coverage": "pnpm exec vitest --coverage",
    "check": "pnpm run format:check && pnpm run type-check && pnpm run lint:check && pnpm run test && pnpm run check-bdd && pnpm run check-test-inventory",
    "fix": "pnpm run lint && pnpm run format",
    "quality-gates": "pnpm run fix && pnpm run check"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "0.62.0",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "0.15.3-canary.f3be22cfeefe",
    "@manypkg/cli": "^0.25.1",
    "@mpsuesser/oxlint-plugin-effect": "^0.6.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "5.0.3",
    "effect": "catalog:",
    "glob": "catalog:",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.71.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.10.0+sha512.122a7b6ddf9d40268bc0db1a9780899b95e4fa8badfca7bd450615ad8cf7c2659f5f569c20ed7c53886bc7b08d0d50a54f4ad50706847f5682ec6c5048416539"
}
