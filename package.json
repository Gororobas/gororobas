{
  "name": "gororobas",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @gororobas/domain --filter @gororobas/effect-bdd --filter @gororobas/effect-sql-turso-browser --filter @gororobas/server --parallel run build",
    "type-check": "pnpm --recursive --if-present --parallel run type-check",
    "lint": "oxlint --fix --fix-dangerously --fix-suggestions --config=./oxlint.config.ts",
    "format": "oxfmt",
    "test": "vitest --run",
    "test:watch": "vitest --run",
    "check-bdd": "pnpm exec tsx packages/effect-bdd/bin/effect-bdd-check.ts check",
    "coverage": "pnpm exec vitest --coverage",
    "quality-gates": "pnpm run format && pnpm run type-check && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-export-namespace-from": "^8.0.1",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@effect/language-service": "^0.87.3",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "^0.15.2",
    "@manypkg/cli": "^0.25.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "effect": "catalog:",
    "glob": "catalog:",
    "lefthook": "^2.1.17",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.19.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@12.9.0+sha512.8f64efa0b792986ca98ae568791bcd7722807e274c4f0c1d9853c62116495c584119db98762a2a5343b1684d361b9ae26fdd16d551666d7635346d3fae830ddd"
}
