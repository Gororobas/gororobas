{
  "name": "gororobas",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "build": "tsc -b tsconfig.build.json && pnpm --filter @gororobas/domain --filter @gororobas/effect-bdd --filter @gororobas/server --parallel run build",
    "type-check": "pnpm --recursive --if-present --parallel run type-check",
    "lint": "oxlint --fix --fix-dangerously --fix-suggestions --config=./oxlint.config.ts",
    "format": "oxfmt",
    "test": "vitest",
    "check-bdd": "bun run packages/effect-bdd/bin/effect-bdd-check.ts check",
    "coverage": "bun --bun ./node_modules/vitest/vitest.mjs --coverage",
    "quality-gates": "pnpm run type-check && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "catalog:",
    "@foldkit/oxlint-plugin": "^0.6.0",
    "@manypkg/cli": "^0.25.1",
    "@mpsuesser/oxlint-plugin-effect": "^0.4.3",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "3.2.4",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "bun": "catalog:",
    "effect": "catalog:",
    "glob": "catalog:",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621"
}
