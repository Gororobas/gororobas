{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mailpit",
      "runtimeExecutable": "mailpit",
      "runtimeArgs": [],
      "port": 8025
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gororobas/server", "start"],
      "env": {
        "AUTH_ORIGIN": "http://localhost:4443"
      },
      "port": 4000
    },
    {
      "name": "api-seeded",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gororobas/server", "start"],
      "env": {
        "API_PORT": "4100",
        "AUTH_ORIGIN": "http://localhost:4543",
        "APP_DB_FILENAME": ":memory:",
        "WORKFLOWS_DB_FILENAME": ":memory:",
        "MEDIA_ASSETS_DIRECTORY": "data/seeded-media-assets",
        "SEED_SCALE": "small"
      },
      "port": 4100
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gororobas/web-app", "dev"],
      "port": 4443
    },
    {
      "name": "web-seeded",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@gororobas/web-app", "dev"],
      "env": {
        "WEB_PORT": "4543",
        "API_PORT": "4100"
      },
      "port": 4543
    }
  ]
}
