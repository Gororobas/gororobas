    "@lingui/core": "catalog:",
    "@pleat/core": "workspace:^",
    "@pleat/foldkit": "workspace:^",
    "@yielded/auth": "catalog:",
    "blobatar": "^2.7.0",
    "effect": "catalog:",
    "effect-units": "catalog:",
    "foldkit": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@foldkit/devtools": "0.170.0-canary.54f8bcd443b4",
