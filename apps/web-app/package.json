  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.design-sync.json",
    "format": "oxfmt",
