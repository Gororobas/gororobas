{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@gororobas/domain": ["../../packages/domain/src/index.ts"],
      "@gororobas/domain/*": ["../../packages/domain/src/*.ts"],
      "@gororobas/domain/test/*": ["../../packages/domain/test/*.ts"],
      "@gororobas/effect-bdd": ["../../packages/effect-bdd/src/index.js"],
      "@gororobas/effect-bdd/*": ["../../packages/effect-bdd/src/*.js"],
      "@gororobas/effect-bdd/test/*": ["../../packages/effect-bdd/test/*.js"],
      "@gororobas/server": ["./src/index.js"],
      "@gororobas/server/*": ["./src/*.js"],
      "@gororobas/server/test/*": ["./test/*.js"]
    }
  }
}
