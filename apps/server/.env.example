NODE_ENV=development
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
AUTH_BINDING_KEY=
# Keys the emailed sign-in codes; generate the same way, distinct from AUTH_BINDING_KEY.
AUTH_PROOF_KEY=
AUTH_ORIGIN=http://localhost:4443
DEEPL_API_KEY=
MAILPIT_URL=http://localhost:8025
AUTH_EMAIL_FROM=auth@gororobas.local
# Relative paths resolve from apps/server when using pnpm --filter @gororobas/server start.
APP_DB_FILENAME=gororobas.db
WORKFLOWS_DB_FILENAME=workflows.db
MEDIA_ASSETS_DIRECTORY=data/media-assets
# Built by `pnpm gazetteer:build --countries co,br`; defaults to data/gazetteer.db, or a small fixture.
# GAZETTEER_DB_FILENAME=data/gazetteer.db

# Optional mirror of CHELSA v2.1 climatologies. Must support HTTP range requests.
# CHELSA_CLIMATOLOGIES_URL=https://os.unil.cloud.switch.ch/chelsa02/chelsa/global/climatologies
# Optional administrative boundary snapshots, named admin-<Who’s On First ID>.geojson.
# CLIMATE_DEM_URL=https://copernicus-dem-90m.s3.amazonaws.com
# CLIMATE_BOUNDARIES_DIRECTORY=data/climate-boundaries
TYPESAFE_AI_API_KEY="apikey_"

# Successful external data is refreshed after this interval; failed fetches are retried hourly.
EXTERNAL_DATA_REFRESH_TIME="14 days"
# Configure a Google Books project key to use its quota for ID suggestions and volume fetching.
GOOGLE_BOOKS_API_KEY=""
# TMDB's API Read Access Token (https://www.themoviedb.org/settings/api), sent as a bearer token.
TMDB_READ_TOKEN=""
