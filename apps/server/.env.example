NODE_ENV=development
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
AUTH_BINDING_KEY=
# Keys the emailed sign-in codes; generate the same way, distinct from AUTH_BINDING_KEY.
AUTH_PROOF_KEY=
AUTH_ORIGIN=http://localhost:4443
DEEPL_API_KEY=
MAILPIT_URL=http://localhost:8025
AUTH_EMAIL_FROM=auth@gororobas.local
# Relative paths resolve from apps/server when using pnpm --filter @gororobas/server start.
APP_DB_FILENAME=gororobas.db
WORKFLOWS_DB_FILENAME=workflows.db
MEDIA_ASSETS_DIRECTORY=data/media-assets
TYPESAFE_AI_API_KEY="apikey_"

# Successful external data is refreshed after this interval; failed fetches are retried hourly.
EXTERNAL_DATA_REFRESH_TIME="14 days"
# Configure a Google Books project key to use its quota for ID suggestions and volume fetching.
GOOGLE_BOOKS_API_KEY=""
