NODE_ENV=development
# Generate with: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
AUTH_BINDING_KEY=
AUTH_ORIGIN=https://localhost:4443
DEEPL_API_KEY=
MAILPIT_URL=http://localhost:8025
AUTH_EMAIL_FROM=auth@gororobas.local
# Relative paths resolve from apps/server when using pnpm --filter @gororobas/server start.
APP_DB_FILENAME=gororobas.db
WORKFLOWS_DB_FILENAME=workflows.db
MEDIA_ASSETS_DIRECTORY=data/media-assets
