{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/domain/tsconfig.build.json"
    },
    {
      "path": "../../packages/effect-bdd/tsconfig.build.json"
    }
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "tsBuildInfoFile": ".tsbuildinfo/build.tsbuildinfo",
