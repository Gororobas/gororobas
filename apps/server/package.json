{
  "name": "@gororobas/server",
  "version": "0.0.0",
  "description": "Server-side logic, policies, and repositories for Gororobas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/hdoro/gororobas-experiments.git",
    "directory": "apps/server"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "scripts": {
    "codegen": "build-utils prepare-v2",
    "build": "pnpm build-annotate && pnpm build-cjs && build-utils pack-v2",
    "build-cjs": "babel build/esm --plugins @babel/transform-export-namespace-from --plugins @babel/transform-modules-commonjs --out-dir build/cjs --source-maps",
    "build-annotate": "babel build/esm --plugins annotate-pure-calls --out-dir build/esm --source-maps",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:watch": "tsc --noEmit -p tsconfig.json -w",
    "test": "vitest",
    "coverage": "vitest --coverage",
    "migrate": "npx tsx scripts/migrate.ts",
    "dev:auth-experiments": "npx tsx --env-file=.env.auth-dev-experiments ./src/auth-dev-experiments-server.ts"
  },
  "dependencies": {
    "@durable-streams/server": "^0.3.9",
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@gororobas/domain": "workspace:^",
    "@mediabunny/server": "^1.61.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@tiptap/core": "catalog:",
    "@tiptap/html": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@yielded/auth": "catalog:",
    "@yielded/auth-persistence": "catalog:",
    "effect": "catalog:",
    "langextract": "^1.2.0",
    "loro-crdt": "catalog:",
    "loro-mirror": "catalog:",
    "mediabunny": "^1.61.0",
    "ollama": "^0.6.4",
    "openid-client": "^6.8.8",
    "sharp": "^0.35.5",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@ariga/atlas": "latest",
    "@durable-streams/client": "catalog:",
    "@effect/vitest": "catalog:",
    "@gororobas/effect-bdd": "workspace:^",
    "sql-formatter": "latest"
  },
  "effect": {
    "generateExports": {
      "include": [
        "**/*.ts"
      ]
    },
    "generateIndex": {
      "include": [
        "**/*.ts"
      ]
    }
  }
}
