{
  "name": "@gororobas/server",
  "version": "0.0.0",
  "description": "Server-side logic, policies, and repositories for Gororobas",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/seed-cli.ts",
    "setup:env": "tsx src/development/setup-environment.ts",
    "dev:sign-in": "tsx --env-file-if-exists=.env src/development/sign-in.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:watch": "tsc --noEmit -p tsconfig.json -w",
    "test": "vitest",
    "test:external": "vitest run --config vitest.external.config.ts",
    "coverage": "vitest --coverage",
    "migrate": "npx tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@gororobas/domain": "workspace:^",
    "@maple-dev/effect-sdk": "catalog:",
    "@mediabunny/server": "^1.61.6",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@tiptap/core": "catalog:",
    "@tiptap/html": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@yielded/auth": "catalog:",
    "@yielded/auth-persistence": "catalog:",
    "effect": "catalog:",
    "langextract": "^1.2.0",
    "loro-crdt": "catalog:",
    "mediabunny": "^1.61.6",
    "ollama": "^0.6.4",
    "sharp": "^0.35.5",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@ariga/atlas": "latest",
    "@effect/vitest": "catalog:",
    "@gororobas/effect-bdd": "workspace:^",
    "sql-formatter": "latest"
  }
}
