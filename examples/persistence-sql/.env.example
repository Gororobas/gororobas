CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AUTH_EMAIL_FROM=hello@effect-agent.com
# AUTH_DATA_DIR=./.data
# AUTH_PORT=4183
# AUTH_ORIGIN=https://your-development-host.example

# GitHub account settings / Yielded sign-in (start:oauth)
# AUTH_PORT=4185
# AUTH_ORIGIN=https://auth.yielded.dev
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_USER_ID=
# Set the following secret to enable OpenID sign-in for Agent.
# YIELDED_AGENT_CLIENT_SECRET must equal Agent's AUTH_YIELDED_CLIENT_SECRET.
# YIELDED_AGENT_CLIENT_SECRET=
# YIELDED_AGENT_ORIGIN=https://agent.yielded.dev
# YIELDED_DISPLAY_NAME=Yielded member
# Cloudflare deploy:oauth also needs the private contents of the two key files.
# Supply these through a secret manager; do not commit their values.
# AUTH_SETTINGS_KEYS=
# AUTH_IDENTITY_KEYS=
